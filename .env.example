# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Persistent PostgreSQL Database Configuration
# Supported: Serverless PostgreSQL (Neon, Supabase, Aiven, or any managed PostgreSQL instance)
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication Secret Key
JWT_SECRET="karnataka-smart-travel-secret-key-2026"
